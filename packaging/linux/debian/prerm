#!/bin/sh
# RustWTM prerm: stop the service and lift what it applied.
set -e
case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl disable --now rustwtm.service >/dev/null 2>&1 || true
        fi
        /usr/bin/wtm-service cleanup >/dev/null 2>&1 || true
        ;;
    upgrade)
        ;;
esac
exit 0
