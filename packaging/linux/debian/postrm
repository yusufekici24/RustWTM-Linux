#!/bin/sh
# RustWTM postrm: purge removes the configuration, history and logs.
set -e
case "$1" in
    purge)
        rm -rf /var/lib/rustwtm /run/rustwtm
        rm -f /etc/dconf/db/local.d/90-rustwtm-shortcut
        if command -v dconf >/dev/null 2>&1; then dconf update || true; fi
        ;;
    remove)
        if [ -d /run/systemd/system ]; then systemctl daemon-reload >/dev/null 2>&1 || true; fi
        ;;
esac
exit 0
